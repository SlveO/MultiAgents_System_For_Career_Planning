DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
BRAIN_DEFAULT_MODEL=deepseek-v4-flash
BRAIN_TIMEOUT_SECONDS=45
BRAIN_RETRY_TIMES=2

# Existing directories on the Ubuntu GPU server. No automatic download.
LOCAL_MODEL_DEVICE=cuda:0
VISION_MODEL_PATH=./models/Qwen3-VL-2B-Instruct
AUDIO_MODEL_PATH=./models/whisper-small

# Explicit existing Qwen3-4B-Instruct-2507 directory; no implicit selection or download.
GUIDANCE_MODEL_PATH=
GUIDANCE_MAX_ROUNDS=4

# Leave empty to reuse the explicitly configured GUIDANCE_MODEL_PATH.
FEEDBACK_MODEL_PATH=
