/data/
/logs/
/request.json
/project/data/test_tmp/
/project/tests/router_case_*/
/project/resources/image/
*.db
*.db-journal

# Optional local models and downloaded material
/models/

# Frontend build output
/web/node_modules/
/web/dist/
/web/*.tsbuildinfo
